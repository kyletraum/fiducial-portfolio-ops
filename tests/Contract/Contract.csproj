<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 runs on Microsoft.Testing.Platform (global.json opts dotnet test in):
         the test project is an executable, and needs no VSTest adapter packages. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Portfolio.Contract</RootNamespace>
  </PropertyGroup>

  <!-- No reference to Api: the test builds it in a child process, the way the committed
       document must be produced, so nothing here can load a stale copy of it. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
