<Project Sdk="Microsoft.NET.Sdk">

  <!-- The E2E runs LOCALLY, not in CI (middle cut). It starts the whole app model on a
       throwaway Postgres and drives the real page. The one project allowed Aspire.Hosting.Testing
       and a reference to the AppHost (tests/Architecture, AspireBoundaryTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 runs on Microsoft.Testing.Platform (global.json opts dotnet test in):
         the test project is an executable, and needs no VSTest adapter packages. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Portfolio.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.6.3" />
    <!-- Lifts a TRANSITIVE dependency of Aspire.Hosting 13.6.1 (directly and via StreamJsonRpc)
         past GHSA-qhrr-8q5h-9q3h (fixed in 2.5.303; 2.5.307 is the latest 2.5.x). Remove once
         Aspire itself depends on >= 2.5.303. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppHost\AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
