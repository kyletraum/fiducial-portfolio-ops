# The documented key list. Copy the keys you need into the .env that
# `aspire publish` writes beside the generated compose file.
#
# NEVER commit `.env` or `.env.<environment>`:
#   .env                  publish writes it KEYS-ONLY, and PRESERVES any value
#                         already present on a later publish. Values you type in
#                         by hand persist; generated secrets never land here.
#   .env.<environment>    the DEPLOY step writes this one with RESOLVED VALUES,
#                         rebuilt from scratch each run. This is the file that
#                         actually carries secrets.
#
# This file lives in deploy/ rather than the publish output directory, which is
# git-ignored as a directory - anything placed there is un-committed by the rule
# that protects the .env.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
