<!-- UPDATED BY HAND: Dependabot does not bump an MSBuild SDK named in this attribute, only
     PackageReferences. Keep it on the same version as the Aspire.* packages below: it pins DCP
     and the dashboard, which come from NuGet (AspireUseCliBundle=false, decided 2026-09-24).
     ON THE NEXT BUMP PAST 13.6.1, check that it carries microsoft/aspire PR #20542 (merged
     2026-10-03, not in 13.6.1): it moves the AuxiliaryBackchannelService connection-reset
     stack traces seen in the VS Code debug console from Debug to Trace, while unexpected
     failures still log as errors. Its companion, PR #20763 (the VS Code extension's
     `aspire ps` follow-mode watcher and duplicate dashboard-URL calls), ships in the extension
     after 1.24.0. Diagnosed 2026-10-20: benign tooling chatter, not an app fault. -->
<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Portfolio.AppHost</RootNamespace>
    <!-- ASPIRE010: DCP and the dashboard come from NuGet (pinned by the SDK version, restored
         and updated like any package) rather than from a machine-installed Aspire CLI.
         Decided 2026-09-24. Revisit if Aspire removes the SDK path (microsoft/aspire#16386). -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>5ff53491-a35f-492d-b73c-32d3c2f136b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
    <ProjectReference Include="..\Migrator\Migrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.4" />
    <!-- Lifts a TRANSITIVE dependency of Aspire.Hosting 13.6.1 (directly and via StreamJsonRpc)
         past GHSA-qhrr-8q5h-9q3h (fixed in 2.5.303; 2.5.307 is the latest 2.5.x). Remove once
         Aspire itself depends on >= 2.5.303. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
  </ItemGroup>
</Project>
